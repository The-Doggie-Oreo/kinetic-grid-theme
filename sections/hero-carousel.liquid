{% liquid
  if section.settings.media_adapt == false
    assign media_mobile_height = section.settings.media_mobile_height | prepend: 'height: ' | append: 'px;'
    assign media_desktop_height = section.settings.media_desktop_height | prepend: 'height: ' | append: 'px;'
  endif

  capture kg_season
    render 'kg-season-slug'
  endcapture
  assign active_season = kg_season | strip

  assign pin_first_id = ''
  assign pin_second_id = ''

  for block in section.blocks
    assign season_tag = block.settings.season_tag | default: ''
    if season_tag != blank and season_tag == active_season
      if block.settings.season_priority == 'second'
        assign pin_second_id = block.id
      else
        assign pin_first_id = block.id
      endif
    endif
  endfor
%}
<div 
  id="hero-carousel-{{ section.id }}" 
  class="
    hero-carousel 
    {{ section.settings.bg_color }} 
    {{ section.settings.bg_gradient }}
    {{ section.settings.text_color }} 
    {{ section.settings.border_top_width | prepend: 'border-top-' }}
    {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }}
    {{ section.settings.border_color }} 
    {{ section.settings.pb | prepend: 'pb-' }} 
    {{ section.settings.pb | prepend: 'pb-' }}
  "
  style="
    --bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }};
    --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};
  ">
  <div 
    id="carousel-{{ section.id }}" 
    class="carousel {{ section.settings.carousel_transition }} {{ section.settings.carousel_effect }}"
    style="--transition-duration: {{ section.settings.carousel_transition_duration | append: 'ms' }};"
    data-bs-ride="{% if section.settings.carousel_autoplay > 0 %}carousel{% else %}false{% endif %}"
    data-bs-interval="{{ section.settings.carousel_autoplay | times: 1000 }}"
    data-bs-pause="false">
    <div class="carousel-inner">
      {% assign slide_index = 0 %}
      {% assign slide_active_set = false %}

      {% if pin_first_id != '' %}
        {% for block in section.blocks %}
          {% if block.id == pin_first_id %}
            {% liquid
              if section.index > 1 or slide_index > 0
                assign media_loading = 'lazy'
              else
                assign media_loading = 'eager'
              endif
            %}
            {% render 'hero-carousel-slide',
              block: block,
              section: section,
              slide_index: slide_index,
              is_active: true,
              media_loading: media_loading
            %}
            {% assign slide_index = slide_index | plus: 1 %}
            {% assign slide_active_set = true %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if pin_second_id != '' and pin_first_id != '' %}
        {% for block in section.blocks %}
          {% if block.id == pin_second_id %}
            {% liquid
              if section.index > 1 or slide_index > 0
                assign media_loading = 'lazy'
              else
                assign media_loading = 'eager'
              endif
            %}
            {% render 'hero-carousel-slide',
              block: block,
              section: section,
              slide_index: slide_index,
              is_active: false,
              media_loading: media_loading
            %}
            {% assign slide_index = slide_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endif %}

        {% assign evergreen_lead_id = '' %}
      {% if pin_second_id != '' and pin_first_id == '' %}
        {% for block in section.blocks %}
          {% assign season_tag = block.settings.season_tag | default: '' %}
          {% if season_tag != blank %}
            {% continue %}
          {% endif %}
          {% liquid
            if section.index > 1 or slide_index > 0
              assign media_loading = 'lazy'
            else
              assign media_loading = 'eager'
            endif
            unless slide_active_set
              assign slide_is_active = true
              assign slide_active_set = true
            else
              assign slide_is_active = false
            endunless
          %}
          {% render 'hero-carousel-slide',
            block: block,
            section: section,
            slide_index: slide_index,
            is_active: slide_is_active,
            media_loading: media_loading
          %}
          {% assign evergreen_lead_id = block.id %}
          {% assign slide_index = slide_index | plus: 1 %}
          {% break %}
        {% endfor %}

        {% for block in section.blocks %}
          {% if block.id == pin_second_id %}
            {% liquid
              if section.index > 1 or slide_index > 0
                assign media_loading = 'lazy'
              else
                assign media_loading = 'eager'
              endif
              unless slide_active_set
                assign pin_second_only_active = true
                assign slide_active_set = true
              else
                assign pin_second_only_active = false
              endunless
            %}
            {% render 'hero-carousel-slide',
              block: block,
              section: section,
              slide_index: slide_index,
              is_active: pin_second_only_active,
              media_loading: media_loading
            %}
            {% assign slide_index = slide_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% for block in section.blocks %}
        {% assign season_tag = block.settings.season_tag | default: '' %}
        {% if season_tag != blank %}
          {% if season_tag != active_season %}
            {% continue %}
          {% endif %}
          {% if block.id == pin_first_id or block.id == pin_second_id %}
            {% continue %}
          {% endif %}
        {% endif %}
        {% if block.id == evergreen_lead_id %}
          {% continue %}
        {% endif %}

        {% liquid
          if section.index > 1 or slide_index > 0
            assign media_loading = 'lazy'
          else
            assign media_loading = 'eager'
          endif
          unless slide_active_set
            assign slide_is_active = true
            assign slide_active_set = true
          else
            assign slide_is_active = false
          endunless
        %}

        {% render 'hero-carousel-slide',
          block: block,
          section: section,
          slide_index: slide_index,
          is_active: slide_is_active,
          media_loading: media_loading
        %}
        {% assign slide_index = slide_index | plus: 1 %}
      {% endfor %}
    </div>
    {% if slide_index > 1 and section.settings.carousel_indicators %}
      <div
        class="carousel-indicators"
        style="--duration: {{ section.settings.carousel_autoplay | append: 's' }}">
        {% assign indicator_last = slide_index | minus: 1 %}
        {% for i in (0..indicator_last) %}
          <button
            type="button"
            data-bs-target="#carousel-{{ section.id }}"
            data-bs-slide-to="{{ forloop.index0 }}"
            class="{% if forloop.first %}active{% endif %}"
            aria-current="{% if forloop.first %}true{% endif %}"
            aria-label="{{ 'general.accessibility.slide_no' | t: number: forloop.index }}">
            <span></span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
    {% if slide_index > 1 and section.settings.carousel_controls %}
      <div class="d-none d-tablet-block">
        <button 
          class="carousel-control carousel-control-prev" 
          type="button" 
          data-bs-target="#carousel-{{ section.id }}" 
          data-bs-slide="prev"
          aria-label="{{ 'general.accessibility.previous' | t }}">
          {% render 'svg-icons', icon: 'chevron-left', size: 24 %}
        </button>
        <button 
          class="carousel-control carousel-control-next" 
          type="button" 
          data-bs-target="#carousel-{{ section.id }}" 
          data-bs-slide="next"
          aria-label="{{ 'general.accessibility.next' | t }}">
          {% render 'svg-icons', icon: 'chevron-right', size: 24 %}
        </button>
      </div>
    {% endif %}
  </div>
</div>

{% if request.design_mode %}
  <script>
    document.addEventListener('shopify:block:select', (event) => {
      const carousel = event.target.closest('#carousel-{{ section.id }}')
    
      if (carousel) {
        bootstrap.Carousel.getOrCreateInstance(carousel, { ride: false })
          .to(event.target.dataset.index)
      }
    })
  </script>
{% endif %}


{% schema %}
