    let index = 0;

    function setValue(form, selector, value) {
      const el = form.querySelector(selector);
      if (!el) return;
      el.value = value;
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
    }

    document.addEventListener('click', (event) => {
      const btn = event.target.closest('[data-kg-trophy-demo-fill]');
      if (!btn) return;

      const root = btn.closest('.kg-trophy-form');
      const form = root && root.querySelector('.kg-trophy-request-form');
      if (!form) return;

      const sample = samples[index % samples.length];
      const n = (index % samples.length) + 1;
      index += 1;

      setValue(form, '#kg-trophy-name', sample.name);
      setValue(form, '#kg-trophy-email', sample.email);
      setValue(form, '#kg-trophy-phone', sample.phone);
      setValue(form, '#kg-trophy-event', sample.event);
      setValue(form, '#kg-trophy-style', sample.style);
