{% schema %}
{
  "name": "KG Trophy request",
  "tag": "section",
  "class": "kg-trophy-form-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Request a custom trophy"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tell us about the event, plaque copy, quantity, and style. Requests email your store owner address from Shopify’s contact form."
    },
    {
      "type": "checkbox",
      "id": "show_demo_fill",
      "label": "Show “Fill sample request” button",
      "default": true,
      "info": "Cycles through 10 demo trophy requests for testing. Turn off when you go live if you don’t want shoppers to see it."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 14
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "KG Trophy request"
    }
  ]
}
{% endschema %}
