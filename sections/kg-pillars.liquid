<div
  id="kg-pillars-{{ section.id }}"
  class="kg-pillars {{ section.settings.pt | prepend: 'pt-' }} {{ section.settings.pb | prepend: 'pb-' }}"
>
  <div class="container">
    {% unless section.settings.title == blank %}
      <div class="row justify-content-center mb-10">
        <div class="col-18 col-desktop-12 text-center">
          <h2 class="kg-section-title h3 mb-4">{{ section.settings.title | escape }}</h2>
          {% unless section.settings.subtitle == blank %}
            <p class="mb-0 text-body">{{ section.settings.subtitle | escape }}</p>
          {% endunless %}
        </div>
      </div>
    {% endunless %}
    <div class="row row-cols-1 row-cols-tablet-2 row-cols-desktop-3 g-6 g-desktop-8">
      {% for block in section.blocks %}
        <div class="col" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a class="kg-card kg-pillar kg-pillar--link p-7 p-desktop-8 text-decoration-none d-block h-100" href="{{ block.settings.link }}">
          {% else %}
            <article class="kg-card kg-pillar p-7 p-desktop-8 h-100">
          {% endif %}
            <div class="kg-pillar__icon" aria-hidden="true">
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | escape }}
              {% else %}
              {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
              {% endif %}
            </div>
            {% unless block.settings.title == blank %}
              <h3 class="mb-4">{{ block.settings.title | escape }}</h3>
            {% endunless %}
            {% unless block.settings.text == blank %}
              <p>{{ block.settings.text | escape }}</p>
            {% endunless %}
          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </article>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KG Pillars",
  "tag": "section",
  "class": "kg-pillars-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Where to start"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Pick a path — catalog prints, awards, or a custom quote."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Index label",
          "info": "Optional. Leave blank to auto-number (01, 02…). Avoid emoji.",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shop the catalog"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Made-to-order 3D prints — gaming gear, organizers, and more."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "KG Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "01",
            "title": "Shop the catalog",
            "text": "Made-to-order 3D prints — gaming gear, organizers, and more."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "02",
            "title": "Awards & plaques",
            "text": "Custom trophies and laser plaques with preset sizes."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "03",
            "title": "Request a quote",
            "text": "Send files and details for custom fabrication."
          }
        }
      ]
    }
  ]
}
{% endschema %}
