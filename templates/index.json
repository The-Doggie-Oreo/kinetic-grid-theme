    "faq_7TT7z4": {
      "type": "faq",
      "blocks": {
        "item_AgKJ3m": {
          "type": "item",
          "settings": {
            "title": "What can you print and engrave?",
            "description": "<p>We offer multi-material 3D printing for gaming gear, sewing organizers, and articulated models, plus 10W diode laser engraving and cutting on hardwoods, slate, acrylic, and anodized aluminum.<\/p>"
          }
        },
        "item_EemRD3": {
          "type": "item",
          "settings": {
            "title": "How long does a made-to-order print take?",
            "description": "<p>Catalog prints are made when you order. Typical turnaround is a few business days depending on size, color changes, and queue. Custom trophies and laser plaques are quoted per job.<\/p>"
          }
        },
        "item_jyLYkB": {
          "type": "item",
          "settings": {
            "title": "Can I send my own 3D or CAD file?",
            "description": "<p>Yes. Use the custom fabrication form for STL, STEP, SVG, or similar files. We quote prototyping and batch production runs from your files.<\/p>"
          }
        },
        "item_pHCJRG": {
          "type": "item",
          "settings": {
            "title": "Do you make custom trophies?",
            "description": "<p>Yes. We combine 3D-printed figures and toppers with engraved plates. Include plaque text, dimensions, and quantity in your request.<\/p>"
          }
        },
        "item_kWLWrb": {
          "type": "item",
          "settings": {
            "title": "What materials do you laser engrave?",
            "description": "<p>Hardwoods, slate, acrylic, and anodized aluminum trophy plates. Tell us the material and size when you request a quote.<\/p>"
          }
        },
        "item_dizKmG": {
          "type": "item",
          "settings": {
            "title": "What is your refund policy?",
            "description": "<p>Made-to-order and custom work is fabricated per job. If something arrives damaged or not as quoted, contact us and we will make it right.<\/p>"
          }
        }
      },
