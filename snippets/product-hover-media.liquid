{% comment %}
  Secondary image shown on product-card hover (STLFlix-style lifestyle shot).
  Skips videos — uses the second product image only.

  Accepts:
  - product: {Object} Product

  Usage:
  {% render 'product-hover-media', product: product %}
{% endcomment %}

{% liquid
  assign hover_image = nil
  assign image_count = 0

  for media in product.media
    if media.media_type == 'image'
      assign image_count = image_count | plus: 1
      if image_count == 2
        assign hover_image = media
        break
      endif
    endif
  endfor
%}

{% if hover_image %}
  {% liquid
    assign hover_alt = hover_image.alt | default: product.title
  %}
  {{
    hover_image
    | image_url: width: 900
    | image_tag:
      loading: 'lazy',
      widths: '400, 600, 900',
      sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw',
      alt: hover_alt,
      class: 'product-card-hover-media'
  }}
{% endif %}
