      setValue(form, '#kg-trophy-plaque', sample.plaque);
      setValue(form, '#kg-trophy-details', sample.details);
      setValue(form, '#kg-trophy-reference', sample.reference);

      const status = root.querySelector('[data-kg-trophy-demo-status]');
      if (status) {
        status.hidden = false;
        status.textContent = 'Loaded sample ' + n + ' of ' + samples.length + ' — click again for the next one.';
      }

      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  })();
